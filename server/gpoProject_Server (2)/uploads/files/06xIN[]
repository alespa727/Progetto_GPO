Table users {
  id int [pk, increment]
  username varchar(20) [not null, unique]
  password varchar(256) [not null]
  isAdmin boolean [default: false]
  timeLastAccess datetime [default: `CURRENT_TIMESTAMP`]
  createdAt date [default: `CURDATE`]
  imagePath varchar(100)
}

Table friendships {
  id int [pk, increment]
  fkUser1 int [not null]
  fkUser2 int [not null]
  createdAt date [default: `CURDATE`]

  Indexes {
    (fkUser1, fkUser2) [unique]
  }
}

Table chats {
  id int [pk, increment]
  fkFriendship int [not null, unique]
  timeLastMessage datetime
  createdAt date [default: `CURDATE`]
}

Table messagesChat {
  id int [pk, increment]
  fkChat int [not null]
  fkUser int [not null]
  message text
  sentAt datetime [default: `CURRENT_TIMESTAMP`]
}

Table attachments {
  id int [pk, increment]
  fkMessage int [not null]
  path varchar(255)
}

Table calls {
  id int [pk, increment]
  fkChat int [not null]
  startTime datetime [default: `CURRENT_TIMESTAMP`]
  endTime datetime
}

Table communities {
  id int [pk, increment]
  fkUserOwner int [not null]
  inviteCode varchar(20) [not null, unique]
  isInviteCodeValid boolean [default: false]
  name varchar(100) [not null]
  description text
  createdAt date [default: `CURDATE`]
}

Table sections {
  id int [pk, increment]
  fkCommunity int [not null]
  name varchar(30) [not null]
}

Table channels {
  id int [pk, increment]
  fkSection int [not null]
  name varchar(100) [not null]
  type enum('testo', 'vocale') [not null]
  description text
  createdAt date [default: `CURDATE`]
}

Table messagesCommunity {
  id int [pk, increment]
  fkChannel int [not null]
  fkUser int [not null]
  message text
  sentAt datetime [default: `CURRENT_TIMESTAMP`]
}

Table registrations {
  fkCommunity int [not null]
  fkUser int [not null]
  date datetime [default: `CURRENT_TIMESTAMP`]

  Indexes {
    (fkCommunity, fkUser) [pk]
  }
}

/* RELAZIONI */

Ref: friendships.fkUser1 > users.id
Ref: friendships.fkUser2 > users.id

Ref: chats.fkFriendship > friendships.id

Ref: messagesChat.fkChat > chats.id
Ref: messagesChat.fkUser > users.id

Ref: attachments.fkMessage > messagesChat.id

Ref: calls.fkChat > chats.id

Ref: communities.fkUserOwner > users.id

Ref: sections.fkCommunity > communities.id

Ref: channels.fkSection > sections.id

Ref: messagesCommunity.fkChannel > channels.id
Ref: messagesCommunity.fkUser > users.id

Ref: registrations.fkCommunity > communities.id
Ref: registrations.fkUser > users.id


Ref: "registrations"."fkUser" < "registrations"."date"
